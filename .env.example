# 2) Señal de la estación — live TV HLS (previous working station feed)
NEXT_PUBLIC_STATION_HLS_URL=https://video.ipstream.cl:3459/hybrid/play.m3u8

# 3) Minuto en la Noticia — news bulletin embed (tvstream.cl VideoPlayer)
NEXT_PUBLIC_MINUTO_EMBED_URL=https://panel.tvstream.cl:2020/VideoPlayer/xzfsepkbtx

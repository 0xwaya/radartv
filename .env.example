# Public site URL used for canonical links and Open Graph
NEXT_PUBLIC_SITE_URL=https://radartv.vercel.app

# Chilean WhatsApp number without spaces or symbols, e.g. 56991248558
NEXT_PUBLIC_WHATSAPP_NUMBER=56991248558

# 1) El Radar Radio — audio-only Icecast/MP3 stream (canonical on deibisromero.com)
